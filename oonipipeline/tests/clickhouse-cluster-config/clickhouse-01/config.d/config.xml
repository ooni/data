<clickhouse replace="true">
    <logger>
        <level>debug</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>
    <display_name>oonidata_cluster node 1</display_name>
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <user_directories>
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <local_directory>
            <path>/var/lib/clickhouse/access/</path>
        </local_directory>
    </user_directories>
    <!-- Needed for ON CLUSTER DDL (CREATE TABLE ... ON CLUSTER in the
         citizenlab updater) to fan out across both replicas. -->
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    <!-- Cluster name matches CLUSTER_NAME in
         citizenlab_test_lists_updater.py: 1 shard, 2 replicas. -->
    <remote_servers replace="true">
        <oonidata_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-01</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>clickhouse-02</host>
                    <port>9000</port>
                </replica>
            </shard>
        </oonidata_cluster>
    </remote_servers>
    <zookeeper>
        <node>
            <host>clickhouse-keeper-01</host>
            <port>9181</port>
        </node>
        <node>
            <host>clickhouse-keeper-02</host>
            <port>9181</port>
        </node>
        <node>
            <host>clickhouse-keeper-03</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <!-- {cluster} and {replica} are used directly in the ZK path/replica
         name that citizenlab_test_lists_updater.py's CREATE TABLE
         statement builds. {shard} isn't referenced by that statement
         (these tables intentionally don't use a sharding key), but is
         defined here for clarity/future use. -->
    <macros>
        <shard>01</shard>
        <replica>01</replica>
        <cluster>oonidata_cluster</cluster>
    </macros>
</clickhouse>
